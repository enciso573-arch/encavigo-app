// Reglas preparadas localmente; publicar solo junto con el nuevo cliente.
// Cuenta propietaria confirmada por el usuario. Otros usuarios autenticados no son administradores.
// Canje: stock y ticket deben cambiar juntos; no se permite repetir un ticket.
// Sesiones: fecha validada con request.time e identidad de Firebase Auth. Pendiente: presencia física y abuso de identidades/telemetría.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null && request.auth.uid == 'ZS4cI7hnMXVPpCaQECFg208TLbL2';
    }
    function vehiculoValido(codigo) {
      return exists(/databases/$(database)/documents/codigos/$(codigo))
        && get(/databases/$(database)/documents/codigos/$(codigo)).data.tipo == 'vehiculo'
        && get(/databases/$(database)/documents/codigos/$(codigo)).data.estado == 'activo'
        && !exists(/databases/$(database)/documents/bajas/$(codigo));
    }
    function sesionValida(code, chofer) {
      let s = get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data;
      return request.auth != null && s.code == code && s.chofer == chofer
        && s.issuedAt <= request.time && request.time < s.issuedAt + duration.value(24, 'h')
        && vehiculoValido(chofer);
    }
    function nuevaSesionValida(uid) {
      let d = request.resource.data;
      return request.auth != null && request.auth.uid == uid
        && d.keys().hasAll(['code','chofer','issuedAt','juegoJugado'])
        && d.keys().hasOnly(['code','chofer','issuedAt','juegoJugado'])
        && d.code is string && d.code.matches('ENC-[A-F0-9]{8}')
        && d.chofer is string && d.chofer.matches('[A-Za-z0-9_-]{1,80}')
        && d.issuedAt == request.time && d.juegoJugado == false && vehiculoValido(d.chofer)
        && !exists(/databases/$(database)/documents/reservas_codigos/$(d.code))
        && getAfter(/databases/$(database)/documents/reservas_codigos/$(d.code)).data.uid == uid
        && getAfter(/databases/$(database)/documents/reservas_codigos/$(d.code)).data.issuedAt == request.time;
    }
    match /sesiones/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid
        && (resource == null || vehiculoValido(resource.data.chofer));
      allow list, delete: if false;
      allow create: if nuevaSesionValida(uid);
      allow update: if (
        request.time >= resource.data.issuedAt + duration.value(24, 'h') && nuevaSesionValida(uid)
      ) || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['juegoJugado'])
        && resource.data.juegoJugado == false && request.resource.data.juegoJugado == true
        && sesionValida(resource.data.code, resource.data.chofer)
      );
    }
    match /reservas_codigos/{code} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','issuedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.issuedAt == request.time
        && getAfter(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data.code == code
        && getAfter(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data.issuedAt == request.time;
      allow read, update, delete: if false;
    }
    function operacionNuevaValida(opId, campId) {
      let op = getAfter(/databases/$(database)/documents/operaciones_canje/$(opId)).data;
      let t = getAfter(/databases/$(database)/documents/tickets/$(op.ticket_id)).data;
      return !exists(/databases/$(database)/documents/operaciones_canje/$(opId))
        && !exists(/databases/$(database)/documents/tickets/$(op.ticket_id))
        && op.camp_id == campId && op.fecha == request.time
        && t.camp_id == campId && t.status == 'quemado' && t.fecha == request.time;
    }
    // Índice privado: el identificador visible en campaigns no revela el código.
    match /operaciones_canje/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ticket_id','camp_id','fecha'])
        && request.resource.data.ticket_id is string && request.resource.data.camp_id is string
        && request.resource.data.fecha == request.time
        && operacionNuevaValida(id, request.resource.data.camp_id)
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.ultima_operacion == id;
      allow read, delete: if esAdmin();
      allow update: if false;
    }
    match /stats/{doc} {
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;

      allow update: if esAdmin();

      allow create, delete: if esAdmin();
    }
    match /choferes/{doc} {
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;

      allow update: if esAdmin();

      allow create, delete: if esAdmin();
    }
    match /campaigns/{doc} {
      allow read: if true;

      allow update: if (
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['clicks'])
                      && request.resource.data.clicks == resource.data.clicks + 1
                    ) || (
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['stock', 'ultima_operacion'])
                      && resource.data.stock is int && resource.data.stock > 0
                      && request.resource.data.stock == resource.data.stock - 1
                      && request.resource.data.ultima_operacion is string
                      && operacionNuevaValida(request.resource.data.ultima_operacion, doc)
                    ) || (

                      esAdmin()
                    );

      allow create, delete: if esAdmin();
    }
    match /tickets/{id} {
      allow create: if request.auth != null
                    && sesionValida(request.resource.data.code, request.resource.data.chofer)
                    && request.resource.data.keys().hasOnly(
                         ['camp_id','negocio','code','chofer','dev','status',
                          'lat','lng','acc','dist_m','revisar','fecha'])
                    && request.resource.data.camp_id is string
                    && request.resource.data.negocio is string
                    && request.resource.data.code    is string
                    && request.resource.data.dev     is string
                    && request.resource.data.status == 'quemado'

                    && id == request.resource.data.negocio + '_' + request.resource.data.code

                    && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id))
                    && get(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.active == true
                    && get(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.stock is int
                    && get(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.stock > 0
                    && get(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.caja_id == request.resource.data.negocio
                    && request.resource.data.chofer is string
                    && request.resource.data.chofer.size() > 0
                    && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 128
                    && request.resource.data.dev.size() > 0 && request.resource.data.dev.size() <= 128
                    && request.resource.data.fecha == request.time
                    && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.stock
                       == get(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.stock - 1
                    && getAfter(/databases/$(database)/documents/operaciones_canje/$(getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.camp_id)).data.ultima_operacion)).data.ticket_id == id;

      allow read, update, delete: if esAdmin();
    }
    match /opiniones/{doc} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['camp_id','negocio','chofer','respetado',
                          'estrellas','comentario','atendida','fecha'])
                    && request.resource.data.respetado is bool
                    && request.resource.data.estrellas is int
                    && request.resource.data.estrellas >= 0
                    && request.resource.data.estrellas <= 5
                    && request.resource.data.comentario is string
                    && request.resource.data.comentario.size() <= 600
                    && request.resource.data.camp_id is string
                    && request.resource.data.negocio is string
                    && request.resource.data.chofer is string
                    && request.resource.data.atendida == false
                    && request.resource.data.fecha == request.time;

      allow read, update, delete: if esAdmin();
    }
    match /codigos/{codigo} {

      allow read: if esAdmin();

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['escaneos'])
                    && request.resource.data.escaneos == resource.data.escaneos + 1;

      allow create, delete: if esAdmin();
      allow update: if esAdmin();
    }
    match /bajas/{codigo} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }
    match /calco_log/{id} {
      allow create: if request.resource.data.keys().hasOnly(['codigo','dev','fecha'])
                    && request.resource.data.codigo is string
                    && request.resource.data.dev is string;
      allow read: if esAdmin();

      allow update: if false;
      allow delete: if esAdmin();
    }
    match /premios/{id} {
      allow create: if false; // Premio desactivado también en servidor durante piloto.
      allow read: if true;
      allow update: if false;
      allow delete: if esAdmin();
    }
    match /interes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['giro','dev','fecha'])
                    && request.resource.data.giro is string
                    && request.resource.data.giro.size() <= 20
                    && request.resource.data.dev is string;
      allow read: if esAdmin();
      allow update: if false;
      allow delete: if esAdmin();
    }
    match /click_log/{id} {
      allow create: if request.resource.data.keys().hasAll(['camp_id','chofer','fecha'])
                    && request.resource.data.keys().hasOnly(['camp_id','chofer','fecha'])
                    && request.resource.data.camp_id is string
                    && request.resource.data.chofer is string
                    && request.resource.data.fecha == request.time;
      allow read: if esAdmin();

      allow update: if false;
      allow delete: if esAdmin();
    }
    match /scan_log/{id} {
      allow create: if request.resource.data.keys().hasAll(['chofer','fecha'])
                    && request.resource.data.keys().hasOnly(['chofer','fecha'])
                    && request.resource.data.chofer is string
                    && request.resource.data.fecha == request.time;
      allow read: if esAdmin();

      allow update: if false;
      allow delete: if esAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
