rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // ESTADISTICAS GLOBALES
    // Cualquiera puede leer y sumar EXACTAMENTE 1 a "clicks".
    // No puede tocar ningun otro campo, ni sumar mas de uno.
    // ─────────────────────────────────────────────────────────────
    match /stats/{doc} {
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;

      allow create, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // CHOFERES
    // Igual que arriba: solo se puede sumar 1 a "clicks".
    // Esto evita que alguien se infle su propio contador de pago.
    // ─────────────────────────────────────────────────────────────
    match /choferes/{doc} {
      allow read: if true;

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;

      allow create, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // CAMPANAS (promociones)
    // Leer: cualquiera.
    // Escribir: SOLO dos movimientos permitidos —
    //   a) sumar 1 a "clicks"
    //   b) restar 1 a "stock", y nunca dejarlo en negativo
    // Crear y borrar: solo tu, con sesion iniciada.
    // ─────────────────────────────────────────────────────────────
    match /campaigns/{doc} {
      allow read: if true;

      allow update: if (
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['clicks'])
                      && request.resource.data.clicks == resource.data.clicks + 1
                    ) || (
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['stock'])
                      && request.resource.data.stock == resource.data.stock - 1
                      && resource.data.stock > 0
                    ) || (
                      /* Tu, desde el panel, puedes editar lo que sea.
                         Sin esta linea el panel no podia guardar ningun
                         cambio: la regla solo permitia sumar un click o
                         restar una existencia, y nada mas. */
                      request.auth != null
                    );

      allow create, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // TICKETS (cupones quemados) — ESTO ES LO QUE SE COBRA
    //
    // El documento se llama: promocion + codigo del cliente.
    // Crear: cualquiera, pero SOLO la primera vez. El segundo intento
    // del mismo codigo en el mismo negocio cuenta como "update", y
    // update aqui esta prohibido -> el cobro no se puede duplicar.
    //
    // Se exige que el nombre del documento coincida con los datos que
    // trae dentro, para que nadie pueda crear un cupon "a mano" con
    // otro nombre y saltarse el candado.
    //
    // Leerlos, corregirlos o borrarlos: solo tu, con sesion iniciada.
    // ─────────────────────────────────────────────────────────────
    match /tickets/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['camp_id','code','chofer','dev','status',
                          'lat','lng','acc','dist_m','revisar','fecha'])
                    && request.resource.data.camp_id is string
                    && request.resource.data.code    is string
                    && request.resource.data.dev     is string
                    && request.resource.data.status == 'quemado'
                    && id == request.resource.data.camp_id + '_' + request.resource.data.code;

      allow read, update, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // OPINIONES Y QUEJAS DE LOS CLIENTES
    // El pasajero deja su opinion despues de quemar el cupon.
    // Crear: cualquiera, pero solo con los campos esperados, para
    //        que nadie use la coleccion de bodega.
    // Leer, cambiar o borrar: solo tu, con sesion iniciada.
    // ─────────────────────────────────────────────────────────────
    match /opiniones/{doc} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['camp_id','negocio','chofer','respetado',
                          'estrellas','comentario','atendida','fecha'])
                    && request.resource.data.respetado is bool
                    && request.resource.data.estrellas is int
                    && request.resource.data.estrellas >= 0
                    && request.resource.data.estrellas <= 5
                    && request.resource.data.comentario.size() <= 600;

      allow read, update, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // REGISTRO DE CLICKS (anti-inflado)
    // Cada registro se llama: promo + celular + fecha.
    // Crear: cualquiera, pero SOLO la primera vez.
    // Si ese registro ya existe, el segundo intento cuenta como
    // "update" y aqui update esta prohibido -> el click no se repite.
    // Leer: solo tu, con sesion iniciada.
    // ─────────────────────────────────────────────────────────────
    match /click_log/{id} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // REGISTRO DE ESCANEOS (anti-inflado)
    // Cada registro se llama: chofer + celular + fecha.
    // Crear: cualquiera, pero SOLO la primera vez.
    // El segundo intento del mismo celular cuenta como "update",
    // y update aqui esta prohibido -> el escaneo no se repite.
    // Leer: solo tu, con sesion iniciada.
    // ─────────────────────────────────────────────────────────────
    match /scan_log/{id} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // TODO LO DEMAS QUEDA CERRADO
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
